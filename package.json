{
  "name": "keyvault-sidekick",
  "version": "2.0.0",
  "description": "Browser-only AES-256-GCM encrypted secrets vault for vibe coders. Multi-tenant build.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=keyvault-sidekick-db --port 8091",
    "deploy": "wrangler pages deploy public --project-name keyvault-sidekick --branch main",
    "db:apply:local": "wrangler d1 migrations apply keyvault-sidekick-db --local",
    "db:apply:remote": "wrangler d1 migrations apply keyvault-sidekick-db --remote",
    "db:execute:remote": "wrangler d1 execute keyvault-sidekick-db --remote --command",
    "create-superadmin": "node scripts/create-superadmin.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.96.0"
  }
}
